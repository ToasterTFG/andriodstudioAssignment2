<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="#000000"> <!-- Black background -->

    <!-- Title Input -->
    <EditText
        android:id="@+id/titleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Book Title"
        android:inputType="text"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="16dp" />

    <!-- Seller Input -->
    <EditText
        android:id="@+id/sellerInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Seller"
        android:inputType="text"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="16dp" />

    <!-- Copies Input -->
    <EditText
        android:id="@+id/copiesInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Number of Copies"
        android:inputType="number"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="16dp" />

    <!-- Price Input -->
    <EditText
        android:id="@+id/priceInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Price"
        android:inputType="numberDecimal"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="16dp" />

    <!-- Bank Input -->
    <EditText
        android:id="@+id/bankInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Bank Details"
        android:inputType="text"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="24dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/submitBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Book"
        android:padding="16dp"
        android:textSize="18sp"
        android:backgroundTint="#FFD700"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>
</LinearLayout>
